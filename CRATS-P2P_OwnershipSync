## 6. Backend Integration (Node.js & WebSockets Example)

A Node.js backend service listens for sync events to update off-chain order books, check limits, and broadcast balance updates via WebSockets.

### 6.1 Event Listener Service (`listener.ts`)
```typescript
import { ethers } from "ethers";
import { Server } from "ws";

const provider = new ethers.JsonRpcProvider(process.env.RPC_URL);
const wsServer = new Server({ port: 8080 });

const SYNC_MANAGER_ADDRESS = "0xAEA3f4E28c9F0122EB8eD2773b79c9743421D007";
const SYNC_MANAGER_ABI = [
  "event SyncRouted(address indexed caller, address indexed asset, address indexed vault, address investor, uint256 balance, bytes32 reasonCode)"
];

const contract = new ethers.Contract(SYNC_MANAGER_ADDRESS, SYNC_MANAGER_ABI, provider);

function broadcastBalanceUpdate(investor: string, asset: string, balance: string, reason: string) {
  const payload = JSON.stringify({
    event: "BALANCE_SYNC",
    data: { investor, asset, balance: ethers.formatEther(balance), reason }
  });
  
  wsServer.clients.forEach(client => {
    if (client.readyState === 1) {
      client.send(payload);
    }
  });
}

export function startListener() {
  console.log("Listening for beneficial ownership synchronization routing events...");
  
  contract.on("SyncRouted", async (caller, asset, vault, investor, balance, reasonCode, event) => {
    const reason = ethers.decodeBytes32String(reasonCode);
    console.log(`Sync Routed: Investor: ${investor} | Asset: ${asset} | Balance: ${ethers.formatEther(balance)} | Reason: ${reason}`);
    
    try {
      // 1. Update SQL Database beneficial ownership cache
      await db.updateOwnershipRecord({
        investorAddress: investor.toLowerCase(),
        assetAddress: asset.toLowerCase(),
        vaultAddress: vault.toLowerCase(),
        shares: balance.toString(),
        txHash: event.log.transactionHash
      });
      
      // 2. Adjust or cancel open Limit Orders if balance fell below active order thresholds
      await db.validateAndPruneOrderbook(investor, asset, balance);

      // 3. Broadcast real-time portfolio updates to clients
      broadcastBalanceUpdate(investor, asset, balance, reason);
      
    } catch (error) {
      console.error("Failed to process sync route update in backend:", error);
    }
  });
}
```

